GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
VOICE=Zephyr

# --- บริบทธุรกิจ (agent profile) ---
# police | hospital | hotel | retail | pawnshop  (ดู src/profiles/)
AGENT_PROFILE=police
# ตั้งชื่อธุรกิจเอง แทน {{business}} ใน prompt/ฐานความรู้ (ไม่ใส่ = ชื่อเริ่มต้นของโปรไฟล์)
# BUSINESS_NAME=ศูนย์บริการข้อมูลตำรวจ

PORT=8080
AUDIOSOCKET_PORT=9093
LOG_DIR=./logs

# --- Postgres + REST API (P0: calls/turns/tickets/analytics) ---
POSTGRES_USER=aileo
# ต้องตั้งใน production (ค่า default ใน compose เป็น placeholder สำหรับ dev เท่านั้น)
# สุ่มด้วย: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
POSTGRES_PASSWORD=
POSTGRES_DB=aileo
# เว้นว่าง = ปิด DB (fallback ไปใช้โปรไฟล์ในโค้ด + log JSONL อย่างเดียว)
DATABASE_URL=postgres://aileo:CHANGE_ME@127.0.0.1:5432/aileo
# พอร์ต REST API สำหรับ console (P3) / analytics (P4)
API_PORT=8090
# ถ้าตั้ง: API จะบังคับ header x-api-key ทุกเส้นทาง /api/* (console proxy แนบให้เอง ฝั่ง browser ไม่เห็น)
# เว้นว่าง = ไม่บังคับ — แนะนำให้ตั้งถ้าเปิด API ออกนอกเครื่อง/หลัง reverse proxy
API_TOKEN=
# tenant เริ่มต้น — ออกแบบให้ multi-tenant ได้ แต่รอบนี้รันลูกค้าเดียว
TENANT_SLUG=watee
TENANT_NAME=WATEE
# cache บริบท agent (ms) — console แก้ agent แล้วมีผลภายในเวลานี้
AGENT_CACHE_TTL_MS=60000

# --- Console (P3) ---
# พอร์ต console (Next.js) — เข้าจากภายนอกผ่าน reverse proxy
CONSOLE_PORT=3000
# secret สำหรับเซ็น session cookie ของ console (ต้องยาวอย่างน้อย 16 ตัวอักษร)
# สุ่มด้วย: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48
CONSOLE_SESSION_SECRET=
# สร้างผู้ใช้ console คนแรกอัตโนมัติตอน boot (ข้ามถ้ามีผู้ใช้อยู่แล้ว) — ล้างค่าเมื่อสร้างเสร็จ
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=
# อายุ session (ชั่วโมง) + จำกัดจำนวนครั้ง login ผิดต่อ IP
CONSOLE_SESSION_TTL_HOURS=12
CONSOLE_LOGIN_MAX_ATTEMPTS=5
CONSOLE_LOGIN_WINDOW_MINUTES=15
# ตั้ง 0 เฉพาะตอน dev ที่เข้า http:// (ปิด Secure flag ของ cookie) — production ปล่อยว่าง
# CONSOLE_COOKIE_SECURE=0

# --- DeepInfra (embeddings + analytics) ---
# คีย์เดียวใช้ทั้ง embedding ของ RAG และวิเคราะห์สายหลังจบ
DEEPINFRA_API_KEY=
# endpoint แบบ OpenAI-compatible (เปลี่ยนได้ถ้าใช้ proxy เอง)
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# --- RAG / embeddings (P1) ---
# โมเดล embedding + มิติ ต้องตรงกับคอลัมน์ knowledge_documents.embedding (embeddinggemma-2 = 768)
EMBED_MODEL=google/embeddinggemma-2
EMBED_DIMS=768
# โฟลเดอร์เก็บไฟล์ต้นฉบับที่อัปโหลด (bridge เขียน / console mount เป็น /uploads แบบอ่านอย่างเดียว)
UPLOAD_DIR=uploads
# โมเดลที่ใช้อ่าน PDF/รูป — Gemini อ่านไทยแม่นและรองรับ PDF สแกน
VISION_MODEL=gemini-3.5-flash

# --- เครื่องมือภายนอก ---
# ราคาทองคำ/เงินของเครื่องมือ check_gold_price
# data_.txt = feed สดที่ตัวเว็บ thaigold.info เรียกใช้เอง (ห้ามใช้ gtdata_.json เพราะค้างอยู่ที่ข้อมูลปี 2011)
GOLD_PRICE_URL=https://www.thaigold.info/RealTimeDataV2/data_.txt
# cache ราคากี่มิลลิวินาที (กันยิงแหล่งข้อมูลถี่เกินตอนมีหลายสาย)
GOLD_PRICE_TTL_MS=60000

# --- Analytics (P4) ---
# วิเคราะห์สายหลังจบ (สรุป + intent + sentiment)
ANALYTICS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# --- Text chat (P2) ---
# โมเดลข้อความสำหรับแชท (ไม่ใช่ Live) — ใช้ generateContent
CHAT_MODEL=gemini-2.5-flash
# LINE Official Account (Messaging API) — webhook ยิงมาที่ POST /line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Outbound (P5) ---
# AMI ของ Asterisk (bridge ใช้สั่งโทรออก) — ถ้าไม่ตั้ง entrypoint จะสุ่มให้ (โทรออกจะใช้ไม่ได้)
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=aileo
AMI_PASSWORD=
# trunk ขาออกที่มีใน pjsip.conf (ยังไม่มีใน config ตัวอย่าง — ต้องเพิ่มก่อนใช้จริง)
OUTBOUND_TRUNK=
OUTBOUND_CALLER_ID=
OUTBOUND_TIMEOUT_MS=30000
# จำนวนสายออกพร้อมกันสูงสุดต่อแคมเปญ (dialer จะ dial เพิ่มเมื่อสายที่ค้างอยู่ต่ำกว่านี้)
CAMPAIGN_BATCH=5

# --- CRM/ERP (P6) ---
# ส่ง context ให้เจ้าหน้าที่ก่อนรับสายโอน (screen pop)
SCREENPOP_URL=

# --- Twilio (ใช้ทดสอบ/PoC) ---
PUBLIC_HOST=callcenter.example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OFFICER_TRANSFER_NUMBER=+66xxxxxxxxx
EMERGENCY_TRANSFER_NUMBER=+66xxxxxxxxx

# --- Asterisk local (docker compose) ---
# IP LAN ของเครื่องที่รัน Asterisk (ห้ามใช้ 0.0.0.0 / public IP)
ASTERISK_BIND_IP=192.168.1.x
# สุ่มด้วย: LC_ALL=C tr -dc 'a-km-np-z2-9' </dev/urandom | head -c 20
SIP_PASSWORD_1001=
SIP_PASSWORD_2001=
SIP_PASSWORD_2002=
RECORD_CALLS=1
# 1 = เซฟ logs/<callId>.in.wav / .out.wav
DEBUG_AUDIO=0

# Docker Desktop (Mac/Windows) ให้ `docker compose up` ใช้ override อัตโนมัติ (Linux ลบบรรทัดนี้)
# COMPOSE_FILE=docker-compose.yml:docker-compose.desktop.yml
