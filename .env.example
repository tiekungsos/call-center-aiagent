GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
VOICE=Zephyr

# --- บริบทธุรกิจ (agent profile) ---
# police | hospital | hotel | retail | pawnshop  (ดู src/profiles/)
AGENT_PROFILE=police
# ตั้งชื่อธุรกิจเอง แทน {{business}} ใน prompt/ฐานความรู้ (ไม่ใส่ = ชื่อเริ่มต้นของโปรไฟล์)
# BUSINESS_NAME=ศูนย์บริการข้อมูลตำรวจ

PORT=8080
AUDIOSOCKET_PORT=9093
LOG_DIR=./logs

# --- Postgres + REST API (P0: calls/turns/tickets/analytics) ---
POSTGRES_USER=aileo
# ต้องตั้งใน production (ค่า default ใน compose เป็น placeholder สำหรับ dev เท่านั้น)
# สุ่มด้วย: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
POSTGRES_PASSWORD=
POSTGRES_DB=aileo
# เว้นว่าง = ปิด DB (fallback ไปใช้โปรไฟล์ในโค้ด + log JSONL อย่างเดียว)
DATABASE_URL=postgres://aileo:CHANGE_ME@127.0.0.1:5432/aileo
# พอร์ต REST API สำหรับ console (P3) / analytics (P4)
API_PORT=8090
# tenant เริ่มต้น — ออกแบบให้ multi-tenant ได้ แต่รอบนี้รันลูกค้าเดียว
TENANT_SLUG=aileo
TENANT_NAME=AILEO
# cache บริบท agent (ms) — console แก้ agent แล้วมีผลภายในเวลานี้
AGENT_CACHE_TTL_MS=60000

# --- Text chat (P2) ---
# โมเดลข้อความสำหรับแชท (ไม่ใช่ Live) — ใช้ generateContent
CHAT_MODEL=gemini-2.5-flash
# LINE Official Account (Messaging API) — webhook ยิงมาที่ POST /line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Twilio (ใช้ทดสอบ/PoC) ---
PUBLIC_HOST=callcenter.example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OFFICER_TRANSFER_NUMBER=+66xxxxxxxxx
EMERGENCY_TRANSFER_NUMBER=+66xxxxxxxxx

# --- Asterisk local (docker compose) ---
# IP LAN ของเครื่องที่รัน Asterisk (ห้ามใช้ 0.0.0.0 / public IP)
ASTERISK_BIND_IP=192.168.1.x
# สุ่มด้วย: LC_ALL=C tr -dc 'a-km-np-z2-9' </dev/urandom | head -c 20
SIP_PASSWORD_1001=
SIP_PASSWORD_2001=
SIP_PASSWORD_2002=
RECORD_CALLS=1
# 1 = เซฟ logs/<callId>.in.wav / .out.wav
DEBUG_AUDIO=0

# Docker Desktop (Mac/Windows) ให้ `docker compose up` ใช้ override อัตโนมัติ (Linux ลบบรรทัดนี้)
# COMPOSE_FILE=docker-compose.yml:docker-compose.desktop.yml
